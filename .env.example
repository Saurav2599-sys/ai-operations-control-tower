# Matches docker-compose.yml's postgres service -- change if you're
# running Postgres some other way.
DATABASE_URL=postgresql+psycopg2://ops_tower:ops_tower@localhost:5432/ops_tower

# How far back (minutes) to look when checking whether an incoming order
# duplicates one already on file. 1440 = 24 hours.
DUPLICATE_WINDOW_MINUTES=1440

# Phase 3: LLM classification (app/classification.py). Needed for
# POST /orders (when required_skills is blank) and POST /orders/{id}/classify
# to actually call out to OpenAI -- without it, classification fails
# gracefully and orders are still accepted (see the README).
OPENAI_API_KEY=

# Defaults to gpt-4o-mini if unset -- cheap and fast enough for a
# synchronous call inside a request. Override to try a stronger model.
OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini

# Minimum confidence (0.0-1.0) before an AI-suggested skill set is copied
# into the authoritative required_skills field. Below this, the suggestion
# is still stored and visible (ai_suggested_skills etc.) but not applied.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
