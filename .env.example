# Matches docker-compose.yml's postgres service -- change if you're
# running Postgres some other way.
DATABASE_URL=postgresql+psycopg2://ops_tower:ops_tower@localhost:5432/ops_tower

# How far back (minutes) to look when checking whether an incoming order
# duplicates one already on file. 1440 = 24 hours.
DUPLICATE_WINDOW_MINUTES=1440
